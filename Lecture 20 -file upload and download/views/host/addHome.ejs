<%- include('../partials/head') %>
  <%- include('../partials/nav') %>

    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet">

    <style>
      body {
        background: linear-gradient(160deg, #fef7ee 0%, #fdf3e4 100%);
        font-family: 'Inter', sans-serif;
        min-height: 100vh;
      }

      /* Form ke small uppercase labels */
      .field-label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.6px;
        text-transform: uppercase;
        color: #6b7280;
        margin-bottom: 4px;
      }

      /* Input fields ki default state */
      .form-input {
        width: 100%;
        box-sizing: border-box;
        padding: 12px 16px;
        font-size: 15px;
        border: 1.5px solid #e5e7eb;
        border-radius: 12px;
        color: #111827;
        background: #fafafa;
        outline: none;
        transition: all 0.2s;
        font-family: 'Inter', sans-serif;
      }

      .form-input::placeholder {
        color: #9ca3af;
      }

      /* Input focus hone par glow effect */
      .form-input:focus {
        border-color: #f97316;
        box-shadow: 0 0 0 4px rgba(249, 115, 22, 0.1);
        background: #fff;
      }

      /* Rupee (₹) symbol waale input field ka wrapper */
      .input-addon {
        display: flex;
        border: 1.5px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
        background: #fafafa;
        transition: all 0.2s;
      }

      .input-addon:focus-within {
        border-color: #f97316;
        box-shadow: 0 0 0 4px rgba(249, 115, 22, 0.1);
      }

      .addon-prefix {
        padding: 12px 14px;
        font-size: 15px;
        font-weight: 500;
        color: #9ca3af;
        background: #f3f4f6;
        border-right: 1.5px solid #e5e7eb;
        display: flex;
        align-items: center;
        user-select: none;
      }

      .addon-input {
        flex: 1;
        padding: 12px 16px;
        font-size: 15px;
        border: none;
        outline: none;
        color: #111827;
        background: transparent;
        font-family: 'Inter', sans-serif;
        min-width: 0;
      }

      /* Two column layout ke liye responsive grid */
      .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }

      /* --- STYLISH FILE UPLOAD BUTTONS --- */
      .custom-file-input {
        display: none;
        /* Purane browser buttons ko hide kiya */
      }

      .custom-file-label {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 14px 20px;
        font-size: 14px;
        font-weight: 500;
        color: #f97316;
        background: rgba(249, 115, 22, 0.05);
        border: 2px dashed rgba(249, 115, 22, 0.3);
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
      }

      .custom-file-label:hover {
        background: rgba(249, 115, 22, 0.1);
        border-color: rgba(249, 115, 22, 0.5);
      }

      .file-chosen-name {
        display: block;
        margin-top: 8px;
        font-size: 12px;
        color: #6b7280;
        font-style: italic;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      /* Orange Submit Button */
      .submit-btn {
        width: 100%;
        margin-top: 28px;
        padding: 15px;
        background: #f97316;
        color: #fff;
        font-weight: 600;
        font-size: 16px;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        letter-spacing: 0.3px;
        font-family: 'Inter', sans-serif;
        transition: all 0.2s ease-in-out;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
      }

      .submit-btn:hover {
        background: #ea6c0a;
        transform: translateY(-2px);
      }

      /* Screen size 500px se kam hone par dono side-by-side inputs ek ke niche ek aa jayenge */
      @media (max-width: 500px) {
        .form-grid {
          grid-template-columns: 1fr;
          gap: 12px;
        }
      }
    </style>
    </head>

    <body>

      <main style="max-width: 500px; margin: 0 auto; padding: 48px 20px 80px;">

        <div style="text-align: center; margin-bottom: 32px;">
          <h1
            style="font-family: 'Playfair Display', serif; font-size: 32px; font-weight: 700; color: #111827; margin: 0 0 10px; line-height: 1.2;">
            List Your House</h1>
          <p style="color: #6b7280; font-size: 15px; margin: 0;">Fill in the details to start hosting guests</p>
        </div>

        <div
          style="background: white; border-radius: 24px; padding: 36px 30px; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05); border: 1px solid #f3f4f6;">

          <form action="/host/add-home" method="POST" enctype="multipart/form-data">

            <div style="margin-bottom: 20px;">
              <label for="houseName" class="field-label">Property Name</label>
              <input type="text" name="houseName" id="houseName" placeholder="e.g. Cozy Lakeside Retreat"
                class="form-input">
            </div>

            <div class="form-grid" style="margin-bottom: 20px;">
              <div>
                <label for="priceNight" class="field-label">Price per Night</label>
                <div class="input-addon">
                  <span class="addon-prefix">₹</span>
                  <input type="number" name="priceNight" id="priceNight" placeholder="2,500" class="addon-input">
                </div>
              </div>
              <div>
                <label for="rating" class="field-label">Rating (1 – 10)</label>
                <input type="number" min="1" max="10" step="0.01" name="rating" id="rating" placeholder="e.g. 4.5"
                  class="form-input">
              </div>
            </div>

            <div style="margin-bottom: 20px;">
              <label for="location" class="field-label">Location</label>
              <input type="text" name="location" id="location" placeholder="e.g. Manali, Himachal Pradesh"
                class="form-input">
            </div>

            <div class="form-grid" style="margin-bottom: 24px;">

              <div>
                <label class="field-label">Photo upload</label>
                <label for="photo" class="custom-file-label">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                  </svg>
                  Upload Image
                </label>
                <input type="file" name="photo" id="photo" class="custom-file-input" accept="image/*"
                  onchange="displayFileName('photo')">
                <span id="photo-file-name" class="file-chosen-name">No image chosen...</span>
              </div>

              <div>
                <label class="field-label">Rules for House (PDF)</label>
                <label for="rulesPdf" class="custom-file-label">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                  </svg>
                  Upload PDF
                </label>
                <input type="file" name="rulesPdf" id="rulesPdf" class="custom-file-input" accept=".pdf"
                  onchange="displayFileName('rulesPdf')">
                <span id="rulesPdf-file-name" class="file-chosen-name">No PDF chosen...</span>
              </div>
            </div>

            <div style="margin-bottom: 4px;">
              <label for="description" class="field-label">Description</label>
              <textarea name="description" id="description" rows="5"
                placeholder="Write a short description about your property..." class="form-input"
                style="resize: vertical; min-height: 120px;"></textarea>
            </div>

            <button type="submit" class="submit-btn">
              List My Property
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </button>

          </form>
        </div>
        <p style="text-align: center; color: #9ca3af; font-size: 14px; margin-top: 20px;">
          Your listing will be reviewed before going live.
        </p>

      </main>

      <script>
        function displayFileName(inputId) {
          const input = document.getElementById(inputId);
          const fileNameSpan = document.getElementById(inputId + '-file-name');

          // Agar user ne file select ki hai to uska naam span me set kar do
          if (input.files.length > 0) {
            fileNameSpan.innerText = input.files[0].name;
            fileNameSpan.style.color = '#111827'; // Darker color for active text
          } else {
            // Agar browse cancel kar diya to default text wapas le aao
            fileNameSpan.innerText = inputId === 'photo' ? 'No image chosen...' : 'No PDF chosen...';
            fileNameSpan.style.color = '#6b7280';
          }
        }
      </script>

    </body>

    </html>