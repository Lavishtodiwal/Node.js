<%- include('../partials/head') %>
  <%- include('../partials/nav') %>

    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet">

    <style>
      body {
        background: linear-gradient(160deg, #fef7ee 0%, #fdf3e4 100%);
        font-family: 'Inter', sans-serif;
        min-height: 100vh;
      }

      .homes-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
      }

      @media (max-width:860px) {
        .homes-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width:540px) {
        .homes-grid {
          grid-template-columns: 1fr;
        }
      }

      .home-card {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 2px 16px rgba(0, 0, 0, .06);
        transition: .25s;
      }

      .home-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, .1);
      }

      .card-img-wrap {
        height: 220px;
        position: relative;
        overflow: hidden;
      }

      .card-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .price-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: #f97316;
        color: white;
        padding: 6px 12px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
      }

      .card-body {
        padding: 18px;
      }

      .card-name {
        margin: 0;
        font-size: 20px;
        color: #111827;
      }

      .card-loc {
        margin: 10px 0;
        color: #6b7280;
        font-size: 14px;
      }

      .card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
      }

      .card-rating {
        color: #f97316;
        font-weight: 600;
      }

      .remove-btn {
        width: 100%;
        border: none;
        background: #ef4444;
        color: white;
        padding: 12px;
        border-radius: 10px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: .25s;
      }

      .remove-btn:hover {
        background: #dc2626;
      }

      .add-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        background: #f97316;
        color: white;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
      }

      .add-btn:hover {
        background: #ea580c;
      }
    </style>

    <body>

      <main style="max-width:1100px;margin:auto;padding:50px 20px;">

        <div
          style="display:flex;justify-content:space-between;align-items:end;margin-bottom:35px;flex-wrap:wrap;gap:15px;">

          <div>
            <h2 style="font-family:'Playfair Display',serif;font-size:34px;margin:0;">
              Your Favorite Homes
            </h2>

            <p style="color:#6b7280;margin-top:6px;">
              <%= favoritesHomes.length %>
                propert<%= favoritesHomes.length==1?'y':'ies' %> available
            </p>
          </div>

          <a href="/host/add-home" class="add-btn">
            + List Yours
          </a>

        </div>

        <% if(favoritesHomes.length===0){ %>

          <div
            style="background:white;padding:70px;border-radius:18px;text-align:center;box-shadow:0 2px 20px rgba(0,0,0,.05);">

            <h3>No Favorite Homes</h3>

            <p style="color:#6b7280;">
              You haven't added any property to your favorites yet.
            </p>

            <a href="/home-list" class="add-btn">
              Browse Homes
            </a>

          </div>

          <% } else { %>

            <div class="homes-grid">

              <% favoritesHomes.forEach(home=>{ %>

                <% if(home){ %>

                  <div class="home-card">

                    <div class="card-img-wrap">

                      <img src="<%= home.photo %>" alt="<%= home.houseName %>">

                      <span class="price-badge">
                        ₹<%= home.priceNight %>/night
                      </span>

                    </div>

                    <div class="card-body">

                      <h3 class="card-name">
                        <%= home.houseName %>
                      </h3>

                      <p class="card-loc">
                        📍 <%= home.location %>
                      </p>

                      <div class="card-footer">

                        <span class="card-rating">
                          ⭐ <%= home.rating %>/10
                        </span>

                      </div>

                      <form action="/favorite/delete/<%= home.id %>" method="POST">

                        <button type="submit" class="remove-btn">
                          Remove from Favorites
                        </button>

                      </form>

                    </div>

                  </div>

                  <% } %>

                    <% }) %>

            </div>

            <% } %>

      </main>

    </body>

    </html>