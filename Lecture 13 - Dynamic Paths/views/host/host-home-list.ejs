<%- include('../partials/head') %>
  <%- include('../partials/nav') %>

    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet">

    <style>
      body {
        background: linear-gradient(160deg, #fef7ee 0%, #fdf3e4 100%);
        font-family: 'Inter', sans-serif;
        min-height: 100vh;
      }

      /* ── Grid ── */
      .homes-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
      }

      @media (max-width: 860px) {
        .homes-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 540px) {
        .homes-grid {
          grid-template-columns: 1fr;
        }
      }

      /* ── Card ── */
      .home-card {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 2px 16px rgba(0, 0, 0, 0.06);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        text-decoration: none;
        display: block;
        color: inherit;
      }

      .home-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 32px rgba(0, 0, 0, 0.10);
      }

      /* ── Card image ── */
      .card-img-wrap {
        height: 200px;
        overflow: hidden;
        position: relative;
        background: #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .card-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
      }

      .home-card:hover .card-img-wrap img {
        transform: scale(1.04);
      }

      .price-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: #f97316;
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        padding: 4px 11px;
        border-radius: 20px;
        letter-spacing: 0.2px;
      }

      /* ── Card body ── */
      .card-body {
        padding: 16px 18px 18px;
      }

      .card-name {
        font-size: 16px;
        font-weight: 600;
        color: #111827;
        margin: 0 0 5px;
      }

      .card-loc {
        font-size: 13px;
        color: #6b7280;
        margin: 0 0 14px;
        display: flex;
        align-items: center;
        gap: 4px;
      }

      .card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .card-rating {
        font-size: 13px;
        color: #f97316;
        font-weight: 600;
      }

      /* ── Header CTA button ── */
      .add-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 18px;
        background: #f97316;
        color: #fff;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14px;
        transition: background 0.18s, transform 0.12s;
      }

      .add-btn:hover {
        background: #ea6c0a;
        transform: translateY(-1px);
      }
    </style>

    </head>

    <body>

      <main style="max-width: 1100px; margin: 0 auto; padding: 48px 24px 80px;">

        <!-- Page header -->
        <div
          style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 32px; flex-wrap: wrap; gap: 12px;">
          <div>
            <h2
              style="font-family: 'Playfair Display', serif; font-size: 32px; font-weight: 700; color: #111827; margin: 0 0 6px; line-height: 1.2;">
              Host Home List
            </h2>
            <p style="font-size: 15px; color: #6b7280; margin: 0;">
              <%= registeredHomes.length %> propert<%= registeredHomes.length===1 ? 'y' : 'ies' %> available
            </p>
          </div>
          <a href="/host/add-home" class="add-btn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
              stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19" />
              <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            List Yours
          </a>
        </div>

        <!-- ── Empty state ── -->
        <% if (registeredHomes.length===0) { %>
          <div
            style="text-align: center; padding: 80px 20px; background: white; border-radius: 20px; box-shadow: 0 2px 20px rgba(0,0,0,0.05);">
            <p style="font-size: 18px; font-weight: 600; color: #374151; margin: 0 0 8px;">No homes listed yet</p>
            <p style="font-size: 14px; color: #9ca3af; margin: 0 0 24px;">Be the first to register your space</p>
            <a href="/host/add-home" class="add-btn" style="display: inline-flex;">
              List a Home →
            </a>
          </div>

          <!-- ── Homes grid ── -->
          <% } else { %>
            <div class="homes-grid">
              <% registeredHomes.forEach(home=> { %>

                <div class="home-card">

                  <!-- Image / placeholder -->
                  <div class="card-img-wrap">
                    <% if (home.photo) { %>
                      <img src="<%= home.photo %>" alt="<%= home.houseName %>">
                      <% } else { %>
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5"
                          stroke-linecap="round" stroke-linejoin="round">
                          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                          <polyline points="9 22 9 12 15 12 15 22" />
                        </svg>
                        <% } %>
                          <span class="price-badge">₹<%= home.priceNight %>/night</span>
                  </div>

                  <!-- Card body -->
                  <div class="card-body">
                    <h3 class="card-name">
                      <%= home.houseName %>
                    </h3>
                    <p class="card-loc">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                        <circle cx="12" cy="10" r="3" />
                      </svg>
                      <%= home.location %>
                    </p>
                    <div class="card-footer">
                      <span class="card-rating">★ <%= home.rating %> / 10</span>
                    </div>
                    <button
                      class="h-8 w-24 bg-[#f97316] text-white rounded-[8px] cursor-pointer shadow-amber-800">Edit</button>
                    <button
                      class="h-8 w-24 bg-[#f97316] text-white rounded-[8px] cursor-pointer shadow-amber-800">Delete</button>
                  </div>

                </div>

                <% }) %>
            </div>
            <% } %>

      </main>

    </body>

    </html>