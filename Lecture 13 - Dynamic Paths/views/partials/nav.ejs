<link
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600&display=swap"
  rel="stylesheet">

<header class="bg-red-500 text-white p-4 shadow-md">
  <nav class="container mx-auto flex justify-between items-center">

    <ul class="flex space-x-4">
      <li>
        <a href="/"
          class="<%= currentPage === 'Home' ? 'bg-red-400' : 'hover:bg-red-400' %> py-2 px-4 rounded transition duration-300">
          Airbnb
        </a>
      </li>
      <li>
        <a href="/home-list"
